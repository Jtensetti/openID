let ingress = Resources.*[ Type == 'AWS::EC2::SecurityGroupIngress' ]
let launch = Resources.HostLaunch.Properties.LaunchTemplateData

rule bounded_host_cost {
  Parameters.InstanceType.Default == 't3.large'
  Parameters.InstanceType.AllowedValues.* IN ['t3.large', 't3.medium']
  %launch.CreditSpecification.CpuCredits == 'standard'
  %launch.Monitoring !exists
  %launch.InstanceMarketOptions !exists
  Resources.*.Type IN ['AWS::EC2::VPC', 'AWS::EC2::InternetGateway', 'AWS::EC2::VPCGatewayAttachment', 'AWS::EC2::Subnet', 'AWS::EC2::RouteTable', 'AWS::EC2::Route', 'AWS::EC2::SubnetRouteTableAssociation', 'AWS::EC2::SecurityGroup', 'AWS::EC2::SecurityGroupIngress', 'AWS::IAM::Role', 'AWS::IAM::Policy', 'AWS::IAM::InstanceProfile', 'AWS::EC2::LaunchTemplate', 'AWS::EC2::Instance', 'AWS::EC2::Volume', 'AWS::EC2::VolumeAttachment', 'AWS::EC2::EIP', 'AWS::EC2::EIPAssociation']
}

rule encrypted_retained_disks {
  %launch.BlockDeviceMappings.*.Ebs.Encrypted == true
  %launch.BlockDeviceMappings.*.Ebs.VolumeType == 'gp3'
  %launch.BlockDeviceMappings.*.Ebs.VolumeSize == 20
  Resources.DataDisk.Properties.Encrypted == true
  Resources.DataDisk.Properties.VolumeType == 'gp3'
  Resources.DataDisk.Properties.Size == 30
  Resources.DataDisk.DeletionPolicy == 'Retain'
  Resources.DataDisk.UpdateReplacePolicy == 'Retain'
}

rule closed_ingress_and_metadata {
  Parameters.PublicIngress.Default == 'false'
  Resources.HostSecurity.Properties.SecurityGroupIngress !exists
  %launch.NetworkInterfaces.*.AssociatePublicIpAddress == false
  %launch.MetadataOptions.HttpTokens == 'required'
  %launch.MetadataOptions.HttpPutResponseHopLimit == 1
  %launch.MetadataOptions.InstanceMetadataTags == 'disabled'
  %launch.KeyName !exists
  %launch.UserData !exists
  %ingress !empty
  %ingress {
    Condition == 'HasPublicIngress'
    Properties.IpProtocol == 'tcp'
    Properties.FromPort IN [80, 443]
    Properties.ToPort == Properties.FromPort
  }
}

rule scoped_runtime_permissions {
  Resources.RuntimePermissions.Condition == 'HasContinuity'
  Resources.RuntimePermissions.Properties.PolicyDocument.Statement.* {
    Effect == 'Allow'
    Action IN ['lambda:InvokeFunction', 'sqs:SendMessage']
    Resource.'Fn::Sub' exists
    Resource.'Fn::Sub' != /\*/
  }
}
